\f0\b0\fs24 \cf0 {{\NeXTGraphic 688d3eff5f714397bf8548f8a59af5548f0e17510f4c4f1db5e84ae4ec20681a.png \width13780 \height12300 \appleattachmentpadding0 \appleembedtype0 \appleaqc
